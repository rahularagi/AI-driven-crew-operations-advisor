# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crew_ops
POSTGRES_USER=crew_ops_user
POSTGRES_PASSWORD=crew_ops_password
DATABASE_URL=postgresql://crew_ops_user:crew_ops_password@localhost:5432/crew_ops

# ─── Mock flags (True = use mock data, False = call real API) ─────────────────
MOCK_CREW_PROFILE=True
MOCK_LICENSE=True
MOCK_FLIGHT_SCHEDULE=True
MOCK_FLIGHT_STATUS=True
MOCK_FTL_STATE=True
MOCK_RESERVE_SCHEDULE=True

# ─── Roster planning ─────────────────────────────────────────────────────
ROSTER_PLANNING_WEEKS=7             # how many weeks ahead the planner builds

# ─── Real API keys (only needed when mock flag is False) ──────────────────────
AVIATIONSTACK_API_KEY=your_key_here
HRMS_API_BASE_URL=https://your-hrms-api.internal
HRMS_API_KEY=your_key_here

# ─── LLM provider (openai / anthropic / bedrock / gemini) ──────────────────────────────────────
USE_LLM=True
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-east-1
